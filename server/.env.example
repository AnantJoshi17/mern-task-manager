# Copy this file, rename the copy to ".env", and fill in your own values.
# Never commit the real .env file — it is already in .gitignore.

PORT=5000

# Option A — MongoDB running on your own computer:
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager

# Option B — free MongoDB Atlas cluster (replace user, password and cluster name):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskmanager?retryWrites=true&w=majority

# Only needed once deployed. Locks the API to your frontend's address.
# Leave it blank locally.
# CLIENT_URL=https://your-frontend.onrender.com
